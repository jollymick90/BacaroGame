# Nome pubblico dell’evento (default: Dev Fest).
PUBLIC_EVENT_NAME=Dev Fest

# Firebase Web SDK: valori pubblici, dalla configurazione dell'app Web Firebase.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=

# Privato, SOLO sul server: JSON del service account (una sola riga).
# Stessa convenzione del progetto svelte-firebase-bacarotech-interview.
FIREBASE_ADMIN_KEY=
# Lista iniziale: email Google verificate, separate da virgole.
# Aggiunte e rimozioni dall’interfaccia superadmin sono salvate su Firestore.
BACARODEX_ALLOWED_EMAILS=
# Superadmin permanenti: email Google verificate, separate da virgole.
# Hanno accesso anche senza essere ripetute in BACARODEX_ALLOWED_EMAILS.
# Non sono revocabili dall’interfaccia; possono nominare altri membri autorizzati.
BACARODEX_SUPERADMIN_EMAILS=

# Solo sviluppo locale con Firebase Emulator Suite e progetto demo-bacarodex.
PUBLIC_FIREBASE_USE_EMULATORS=false

# Privato: segreto casuale >=32 caratteri per i tentativi del quiz pubblico.
# Genera con: openssl rand -hex 32
BACARODEX_GAME_SECRET=
