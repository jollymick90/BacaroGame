{
  "name": "bacarodex",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "check": "npm run check:collections && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "models": "node scripts/setup-models.mjs",
    "build": "npm run check:collections && npm run models && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "prepare": "svelte-kit sync",
    "emulators": "npx --yes firebase-tools@15.34.0 emulators:start --only auth,firestore --project demo-bacarodex",
    "firebase:up": "docker compose --env-file .env.emulator.example up --build -d --wait",
    "firebase:down": "docker compose --env-file .env.emulator.example down",
    "firebase:logs": "docker compose --env-file .env.emulator.example logs -f firebase",
    "test:merge-battle": "node --experimental-strip-types --test src/lib/games/merge-battle/engine.test.ts src/lib/games/merge-battle/config.test.ts src/lib/games/merge-battle/cards.test.ts",
    "test:bug-hunter": "node --experimental-strip-types --test src/lib/games/bug-hunter/mechanics.test.ts src/lib/games/bug-hunter/gameplay.test.ts",
    "check:collections": "node --experimental-strip-types scripts/check-firestore-collections.mjs",
    "test:collections": "node --experimental-strip-types --test src/lib/firebase/collections.test.ts scripts/check-firestore-collections.test.mjs",
    "test:superadmins": "node --experimental-strip-types --test src/lib/server/admin-policy.test.ts tests/superadmins-api.test.mjs",
    "test:ai": "node --experimental-strip-types --test src/lib/games/are-you-an-ai/trials.test.ts src/lib/games/are-you-an-ai/certificate.test.ts",
    "test:qr": "node --experimental-strip-types --test src/lib/game-center/share.test.ts",
    "test:recognition": "node --experimental-strip-types --test src/lib/face-analysis.test.ts src/lib/server/face-match.test.ts",
    "dev:local": "node scripts/dev-local.mjs",
    "dev:cloud": "vite --host 0.0.0.0",
    "test:local": "node --test scripts/local-environment.test.mjs"
  },
  "dependencies": {
    "@vladmandic/human": "3.3.6",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "pdf-lib": "1.17.1",
    "qrcode": "^1.5.4",
    "svelte": "^5.0.0",
    "three": "0.171.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tsconfig/svelte": "^5.0.0",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/three": "0.171.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6",
    "cookie": "^0.7.2",
    "jwks-rsa": {
      "jose": "^5.10.0"
    }
  },
  "engines": {
    "node": "^22.17.0"
  }
}
